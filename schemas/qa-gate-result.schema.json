{
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ],
      "description": "PASS when the task deliverable satisfies its acceptance criteria and is internally coherent/evidence-based. FAIL only when the deliverable itself is inadequate. Do not FAIL merely because the underlying product has defects documented by the deliverable."
    },
    "evidence": {
      "type": "string"
    },
    "findings": {
      "type": "string"
    },
    "criteria_assessment": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "description": "Structured assessment of concrete task/role acceptance criteria.",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "status": {
            "type": "string",
            "enum": [
              "SATISFIED",
              "UNSATISFIED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        },
        "required": [
          "criterion",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outcome",
    "evidence",
    "findings",
    "criteria_assessment"
  ],
  "additionalProperties": false
}
