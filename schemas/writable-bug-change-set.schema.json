{
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["COMPLETED", "BLOCKED"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "report_markdown": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "enum": ["WRITE", "DELETE"] },
          "content": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["path", "operation", "content", "reason"],
        "additionalProperties": false
      }
    },
    "verification_commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "string"
    },
    "blockers": {
      "type": "string"
    },
    "recommended_next": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic_plan": {
  "type": "object",
  "properties": {
    "reproduction_signal": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["COMMAND"] },
        "command": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "working_directory": { "type": "string", "enum": ["."] },
        "broken_when": { "type": "string", "enum": ["EXIT_ZERO", "EXIT_NONZERO"] }
      },
      "required": ["kind", "command", "working_directory", "broken_when"],
      "additionalProperties": false
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "prediction": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "falsifier": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "experiment_command": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "supported_when": { "type": "string", "enum": ["EXIT_ZERO", "EXIT_NONZERO"] }
        },
        "required": [
          "id",
          "statement",
          "prediction",
          "falsifier",
          "experiment_command",
          "supported_when"
        ],
        "additionalProperties": false
      }
    },
    "cause": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["CONFIRMED", "UNCONFIRMED"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "hypothesis_refs": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      },
      "required": ["status", "statement", "hypothesis_refs"],
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "properties": {
        "classification": { "type": "string", "enum": ["REPAIR", "WORKAROUND"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "residual_risk": { "type": "string", "maxLength": 1500 }
      },
      "required": ["classification", "summary", "residual_risk"],
      "additionalProperties": false
    }
  },
  "required": ["reproduction_signal", "hypotheses", "cause", "resolution"],
  "additionalProperties": false
}
  },
  "required": [
    "outcome",
    "summary",
    "report_markdown",
    "changes",
    "verification_commands",
    "verification",
    "decisions",
    "blockers",
    "recommended_next"
  ],
  "additionalProperties": false
}
