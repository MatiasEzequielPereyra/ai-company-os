{
  "type": "object",
  "properties": {
    "source_task_id": {
      "type": "string",
      "pattern": "^AICO-[0-9]{3,}$"
    },
    "work_request_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "DECISION",
              "IMPLEMENTATION",
              "VALIDATION",
              "OPERATIONS"
            ]
          },
          "title": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "enum": [
              "ceo",
              "pm",
              "cto",
              "engineering-manager",
              "backend",
              "frontend",
              "devops",
              "qa",
              "security"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "objective": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testing_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "key",
          "kind",
          "title",
          "owner",
          "priority",
          "objective",
          "context",
          "acceptance_criteria",
          "dependencies",
          "affected_areas",
          "testing_requirements",
          "risks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source_task_id",
    "work_request_id",
    "summary",
    "items"
  ],
  "additionalProperties": false
}
