{
  "type": "object",
  "properties": {
    "recommendation": {
      "type": "string",
      "enum": [
        "APPROVE",
        "CHANGES_REQUIRED"
      ],
      "description": "APPROVE when the assigned task deliverable is complete, evidence-based and fit to proceed. CHANGES_REQUIRED only when the deliverable itself is materially incomplete, unsupported, contradictory, or fails its acceptance criteria. Product defects discovered by the deliverable are not by themselves a reason to request changes."
    },
    "findings": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "missing_required_outputs": {
      "type": "array",
      "description": "Material outputs required by the original owner role/task that are absent from the delivered report.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 30
    },
    "deliverable_defects": {
      "type": "array",
      "description": "Concrete defects of the deliverable itself. Product defects merely documented by a valid audit/planning deliverable do not belong here.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800
      },
      "maxItems": 30
    },
    "contract_version": {
      "enum": [
        "review-grounding-v1"
      ],
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "type": "string",
      "maxLength": 200
    },
    "assessments": {
      "items": {
        "type": "object",
        "properties": {
          "required_output_id": {
            "minLength": 1,
            "type": "string",
            "maxLength": 1024
          },
          "status": {
            "enum": [
              "SATISFIED",
              "UNSATISFIED",
              "NOT_APPLICABLE"
            ],
            "type": "string"
          },
          "rationale": {
            "minLength": 1,
            "type": "string",
            "maxLength": 2000
          },
          "evidence": {
            "items": {
              "type": "object",
              "properties": {
                "artifact_id": {
                  "minLength": 1,
                  "type": "string",
                  "maxLength": 200
                },
                "start_line": {
                  "minimum": 1,
                  "type": "integer"
                },
                "end_line": {
                  "minimum": 1,
                  "type": "integer"
                },
                "excerpt": {
                  "maxLength": 2048,
                  "type": "string"
                }
              },
              "required": [
                "artifact_id",
                "start_line",
                "end_line",
                "excerpt"
              ],
              "additionalProperties": false
            },
            "maxItems": 3,
            "type": "array"
          },
          "conditional_authority": {
            "minLength": 1,
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "required_output_id",
          "status",
          "rationale",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64,
      "type": "array"
    }
  },
  "required": [
    "recommendation",
    "findings",
    "verification",
    "missing_required_outputs",
    "deliverable_defects",
    "contract_version",
    "snapshot_id",
    "assessments"
  ],
  "additionalProperties": false
}
